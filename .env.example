# 登录认证配置
# 默认凭证与源码默认值保持一致；生产环境必须修改。
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# 用于签名后台 HTTP-only 登录 cookie。生产环境必须改成高强度随机字符串。
AUTH_SECRET=replace_with_a_long_random_secret

# DNS 运行配置默认值，可在后台配置面板中修改
DNS_CACHE_ENABLED=true
DNS_CACHE_TTL=300
DNS_CACHE_MAX_ENTRIES=1000
DNS_ENABLE_LOGGING=true
DNS_MAX_LOG_ENTRIES=1000
DNS_RATE_LIMIT=0
DNS_UPSTREAM_POLICY=priority
DNS_UPSTREAM_TIMEOUT=5000
# 域名过滤模式：off=关闭 / blacklist=命中规则的域名被过滤 / whitelist=仅命中规则的域名走DoH
DNS_FILTER_MODE=blacklist
# 命中动作：refuse=返回REFUSED（被过滤网站会打不开，Chrome/Edge安全模式不会回退本地DNS）
#           direct=分流到直连解析器（其他网页正常加载，推荐搭配白名单做DoH分流）
DNS_FILTER_ACTION=direct
# 直连解析器：udp://IP[:端口]（明文DNS，等价本地解析）或 https://.../dns-query（另一组DoH）
DNS_DIRECT_RESOLVER=udp://223.5.5.5
DNS_BLOCKLIST=
# SNI 阻断代答：命中规则的域名 A 查询返回虚拟 IP，交由本地代理 SNI 嗅探接管
DNS_FAKE_IP_RULES=
DNS_FAKE_IP=198.18.0.1

# 存储配置（三选一，优先级：KV > Redis > 内存）
# 1. Vercel KV（推荐，Vercel 部署时自动配置）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 2. Redis（自托管或其他平台部署时使用）
# 留空则使用内存存储；内存模式重启后设置和统计会丢失。
REDIS_URL=

# 3. 内存存储（无需配置，重启后数据丢失）